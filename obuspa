#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
PROG="/usr/sbin/obuspa"
DB="/etc/obuspa/db/usp.db"

start_service() {
    procd_open_instance

    procd_set_param env USP_ENDPOINT_ID="os::012345-MANALA000001"

procd_set_param command "$PROG" \
    -f "$DB" \
    -v 4 \
    -p

    procd_set_param respawn 3600 5 5

    procd_close_instance
}

stop_service() {
    killall obuspa 2>/dev/null
}
